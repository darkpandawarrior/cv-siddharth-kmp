<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window under a dark-only app: no white flash at launch. #0A0D0C is CvDarkColors.ink. -->
    <style name="Theme.Cv" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0A0D0C</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
